PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/fooddelivery
# Recommended in production: strong random string for signing auth tokens
JWT_SECRET=
# Optional: comma-separated allowed frontend origins for CORS (leave empty to allow all)
CORS_ORIGIN=
# Optional: set to false when deploying frontend separately from backend
SERVE_FRONTEND=true
